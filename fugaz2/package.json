{
  "name": "fugazchat",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "FugazChat 2.0 — E2EE serverless P2P (Signal Protocol + WebRTC DataChannel + cloudflared tunnel)",
  "type": "module",
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.2.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build": "vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit",
    "check:protocol": "node scripts/sync-protocol.js --check",
    "sync:docs": "node scripts/sync-protocol.js --docs",
    "lint": "eslint src/ --fix",
    "prepare": "husky install"
  },
  "dependencies": {
    "@privacyresearch/libsignal-protocol-typescript": "^0.0.16",
    "dompurify": "^3.0.13",
    "katex": "^0.16.11",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.11",
    "@types/marked": "^6.0.1",
    "@vitest/browser": "^3.0.0-beta.1",
    "vite": "^5.4.2",
    "vitest": "^3.0.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.7.2",
    "eslint": "^9.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "tauri": "^2.0.0",
    "playwright": "^1.49.0",
    "happy-dom": "^15.11.0",
    "husky": "^9.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": true, "open": true }
    },
    "updater": {
      "active": true
    }
  }
}
