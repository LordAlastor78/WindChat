# WindChat Server Configuration
#
# Copia este archivo a .env y ajusta lo que necesites.
# Todas las variables son opcionales: el servidor arranca sin .env.

# Puerto del servidor HTTP + WebSocket
PORT=8080

# Entorno. En "production" se activan HSTS y una CSP sin unsafe-inline.
NODE_ENV=development

# ---------------------------------------------------------------------
# Privacidad
# ---------------------------------------------------------------------

# Logging de metadatos por mensaje: roomId, nombres, tamaños, quién habla
# con quién. Desactivado por defecto para no registrar nada de eso.
# Actívalo solo para depurar en local.
# VERBOSE_LOGS=true

# ---------------------------------------------------------------------
# Salud y heartbeat (opcional, hay valores por defecto razonables)
# ---------------------------------------------------------------------

# Intervalo entre barridos de ping (ms). También es la tolerancia efectiva
# antes de cerrar un socket que no responde, porque el barrido es de dos fases.
# HEARTBEAT_INTERVAL_MS=30000

# Ventana para contabilizar eventos de salud (ms)
# HEALTH_WINDOW_MS=60000

# Frecuencia de evaluación del estado del servidor (ms)
# EVALUATE_INTERVAL_MS=15000

# Errores en la ventana antes de marcar el servidor como "degraded"
# DEGRADED_THRESHOLD=5

# ---------------------------------------------------------------------
# TLS local opcional (para desarrollo con HTTPS/WSS sin túnel)
# ---------------------------------------------------------------------

# LOCAL_HTTPS=true
# HTTPS_KEY_PATH=./certs/localhost-key.pem
# HTTPS_CERT_PATH=./certs/localhost-cert.pem
# HTTPS_PASSPHRASE=changeit

# En producción tras Cloudflare Tunnel no hace falta configurar TLS aquí:
# el túnel termina el HTTPS.

# ---------------------------------------------------------------------
# Nota: MAX_USERS_PER_ROOM (2) y MAX_MESSAGE_SIZE (10 MB) NO son variables
# de entorno. Son constantes del protocolo en shared/protocol.ts, porque
# cliente y servidor deben coincidir. Cámbialas allí si hace falta.
# ---------------------------------------------------------------------
