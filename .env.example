# WindChat Server Configuration

# Puerto del servidor WebSocket
PORT=8080

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Usuarios máximos por room (hard limit)
MAX_USERS_PER_ROOM=2

# Timeout de room inactiva (ms)
ROOM_TIMEOUT=30000

# Tamaño máximo de mensaje (bytes)
MAX_MESSAGE_SIZE=10485760

# HTTPS/WSS (para producción con Cloudflare Tunnel)
# No necesitas configurar aquí, CF Tunnel lo maneja
