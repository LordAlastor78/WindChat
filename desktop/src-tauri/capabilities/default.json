{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilidades por defecto de WindChat Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/relay-rust", "sidecar": true, "args": true },
        { "name": "binaries/cloudflared", "sidecar": true, "args": true },
        { "name": "relay-rust", "sidecar": true, "args": true },
        { "name": "cloudflared", "sidecar": true, "args": true }
      ]
    }
  ]
}
