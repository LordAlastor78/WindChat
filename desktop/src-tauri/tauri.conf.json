{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindChat",
  "version": "1.0.0",
  "identifier": "com.windchat.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "pushd ..\\..\\client && npx vite preview --port 4173 --strictPort",
    "beforeBuildCommand": "echo skip"
  },
  "app": {
    "windows": [
      {
        "title": "WindChat",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [
      "binaries/relay-rust"
    ]
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/<GITHUB_USER>/WindChat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IFBUE3hYRFZycyBCaW5hcnkgcGxhY2Vob2xkZXIgLS0gcmVlbXBsYXogY29uIGxhIGNsYXZlIFBVQkxJQ0Egb24gPGEgdGF1cmkgc2lnbmVyIGdlbmVyYXRlPiBhbmQgcGVnYWhlIGxhIHB1YmtleSBlbiB0YXVyaS5jb25mLmpzb24="
    }
  }
}
