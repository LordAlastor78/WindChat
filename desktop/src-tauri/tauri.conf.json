{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindChat",
  "version": "1.1.0",
  "identifier": "com.windchat.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "cd ../client && npx vite preview --port 4173 --strictPort",
    "beforeBuildCommand": "cd ../client && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WindChat",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [
      "binaries/relay-rust",
      "binaries/cloudflared"
    ]
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/LordAlastor78/WindChat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1tZW50OiBtaW5pc2lnbiBwdWJsaWMga2V5OiA2OEE0RkRCMVQ1RkEzODNBCkJXVTZPUHJGSWYyazFIYXZmNkxMVVF4aU1VZGdvNDBvZC9mczM5WDFYN3R2Y2ZMbTBvWG8K"
    }
  }
}
